# ==============================================================================
# End-to-End Deepfake Voice Analysis & Fraud Prevention Framework
# Backend Configuration Template
# ==============================================================================

# Application Meta
APP_NAME="Deepfake Audio Detection & Fraud Prevention API"
APP_VERSION=1.0.0
ENVIRONMENT=development
DEBUG=false

# Server Networking
HOST=0.0.0.0
PORT=8000

# Cross-Origin Resource Sharing (CORS)
FRONTEND_ORIGIN=http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# File Upload Limits
MAX_UPLOAD_SIZE_MB=25
UPLOAD_CHUNK_SIZE=1048576

# Database & Audit Logging (Optional)
MONGODB_URI=mongodb://localhost:27017/deepfake_voice_db
