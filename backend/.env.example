# Copy to .env and adjust. Everything here is optional, the defaults match
# the values below.
HOST=127.0.0.1
PORT=8000

# Comma separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Older single-origin variable, still added to CORS_ORIGINS if set
# FRONTEND_ORIGIN=https://your-frontend.example.com

# Sizes in bytes (25 MB and 1 MB)
MAX_UPLOAD_SIZE=26214400
UPLOAD_CHUNK_SIZE=1048576
